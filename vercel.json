{
  "functions": {
    "pages/api/**/*.js": {
      "maxDuration": 30
    },
    "src/app/api/research/feed/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/smart-alerts/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/research-ingest/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/research-feeds/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/research-index/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/daily-metrics-snapshot/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/smart-alerts",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/disabled-cron",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/disabled-cron",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/disabled-cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/disabled-cron",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-metrics-snapshot",
      "schedule": "55 23 * * *"
    }
  ]
}
