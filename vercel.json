{
  "functions": {
    "pages/api/**/*.js": {
      "maxDuration": 30
    },
    "src/app/api/research/feed/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/smart-alerts/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/research-ingest/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/research-feeds/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/smart-alerts",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/research-ingest",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/research-profiles",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/research-feeds",
      "schedule": "0 6 * * *"
    }
  ]
}