{
  "_crons_note": "Cron jobs below are defined here for reference. To disable individual crons without editing this file, use the Vercel dashboard: Project > Settings > Cron Jobs. Do NOT delete entries here — manage them at the dashboard level.",
  "functions": {
    "pages/api/**/*.js": {
      "maxDuration": 30
    },
    "src/app/api/research/feed/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/smart-alerts/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/research-ingest/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/research-feeds/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/research-index/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/daily-metrics-snapshot/route.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/smart-alerts",
      "schedule": "30 8 * * *"
    },
    {
      "path": "/api/cron/research-ingest",
      "schedule": "0 0 31 2 *"
    },
    {
      "path": "/api/cron/research-profiles",
      "schedule": "0 0 31 2 *"
    },
    {
      "path": "/api/cron/research-feeds",
      "schedule": "0 0 31 2 *"
    },
    {
      "path": "/api/cron/research-index",
      "schedule": "0 0 31 2 *"
    },
    {
      "path": "/api/cron/daily-metrics-snapshot",
      "schedule": "55 23 * * *"
    }
  ]
}
