generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum ContentType {
  PAPER
  BOOK
  ARTICLE
  BLOG
  ESSAY
  POLICY_REPORT
  OTHER
}

enum QueueItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QueueInputType {
  URL
  PAPER
  BOOK
}

enum ReadingStatus {
  UNREAD
  BACKLOG
  IN_PROGRESS
  READING
  COMPLETED
  READ
  DROPPED
}

enum Plan {
  FREE
  PRO
  LIFETIME_PRO
}

enum CollectionRole {
  VIEWER
  CONTRIBUTOR
  ADMIN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum SharedEntryStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum SignalType {
  ENTRY_SAVED
  ENTRY_ADDED_TO_COLLECTION
  COLLECTION_MADE_PUBLIC
  CONNECTION_MADE
  PAPER_SHARED
  REFERENCE_REQUESTED
  COLLECTION_MEMBER_JOINED
}

enum ReferenceRequestStatus {
  PENDING
  ACKNOWLEDGED
  DISMISSED
}

enum EntrySource {
  MANUAL
  SMART_ALERT
}

enum NotificationType {
  SMART_ALERT
  CONNECTION_REQUEST
  SHARED_ENTRY
  COLLECTION_INVITE
}

enum AlertEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

model Topic {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  explanation String?  @db.Text
  keyConcepts String[] @default([])
  createdAt   DateTime @default(now())
}

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  name                  String?
  username              String?     @unique
  bio                   String?
  passwordHash          String?
  plan                  Plan        @default(FREE)
  stripeCustomerId      String?     @unique
  stripeSubscriptionId  String?     @unique
  stripePriceId         String?
  subscriptionStatus    String?
  subscriptionEndsAt    DateTime?
  emailVerified         DateTime?
  createdAt             DateTime    @default(now())
  showSignals           Boolean     @default(true)
  lastFeedViewedAt      DateTime?
  usernameBannerShown   Boolean     @default(false)
  entriesCount          Int         @default(0)
  personalCollectionsCount Int       @default(0)
  timezone              String      @default("UTC")

  entries               Entry[]
  collections           Collection[]
  promoCodes            PromoCode[]
  collectionMemberships CollectionMember[]
  sentInvites           CollectionMember[]  @relation("InvitedBy")
  sentConnections       Connection[]        @relation("ConnectionRequester")
  receivedConnections   Connection[]        @relation("ConnectionReceiver")
  sentSharedEntries     SharedEntry[]       @relation("SharedEntrySender")
  receivedSharedEntries SharedEntry[]       @relation("SharedEntryReceiver")
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  signals               Signal[]
  sentReferenceRequests ReferenceRequest[] @relation("ReferenceRequester")
  receivedReferenceRequests ReferenceRequest[] @relation("ReferenceOwner")
  analyticsEvents       AnalyticsEvent[]
  feedback              Feedback[]
  queueItems            QueueItem[]
  watchQueries          WatchQuery[]
  notifications         Notification[]
  alertContainers       AlertContainer[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Entry {
  id            String        @id @default(cuid())
  title         String
  slug          String?       @unique
  metaDescription String?     @db.Text
  authors       String[]
  year          Int?
  // contentType is retained for data integrity and potential future use.
  // It is no longer displayed in the UI or used for filtering.
  // Do not delete this column or its data.
  contentType   ContentType   @default(PAPER)
  url           String?       @unique
  doi           String?       @unique
  source        EntrySource    @default(MANUAL)
  addedByQueryId String?
  abstract      String?
  publishers    String[]      @default([])
  publishDate   String?
  numberOfPages Int?
  description   String?
  isbn13        String[]      @default([])
  cover         String?
  summary       String?
  userKeywords  String[]      @default([])
  autoKeywords  String[]      @default([])
  notes         Json          @default("[]")
  metadata      Json?
  readingStatus ReadingStatus @default(UNREAD)
  createdAt     DateTime      @default(now())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  collections   EntryCollection[]
  sharedEntries SharedEntry[]
  signals       Signal[]
  referenceRequests ReferenceRequest[]
  watchQuery    WatchQuery?       @relation("WatchQueryEntries", fields: [addedByQueryId], references: [id])
}

model Collection {
  id               String             @id @default(cuid())
  name             String
  description      String?
  isShared         Boolean            @default(false)
  isPublic         Boolean            @default(false)
  publicSlug       String?            @unique
  publicDescription String?           @db.Text
  publicViewCount  Int                @default(0)
  metadata        Json?
  createdAt        DateTime           @default(now())
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  entries          EntryCollection[]
  members          CollectionMember[]
  signals          Signal[]
  watchQueries     WatchQuery[]
  alertContainers  AlertContainer[]
}

model WatchQuery {
  id            String    @id @default(cuid())
  userId        String
  query         String
  collectionId  String
  maxPapers     Int       @default(5)
  isActive      Boolean   @default(true)
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entries       Entry[]   @relation("WatchQueryEntries")
  alertContainers AlertContainer[]
  
  @@index([userId])
  @@index([lastCheckedAt])
  @@index([isActive, lastCheckedAt])
}

model AlertContainer {
  id           String     @id @default(cuid())
  userId       String
  watchQueryId String
  query        String
  collectionId String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchQuery   WatchQuery @relation(fields: [watchQueryId], references: [id], onDelete: Cascade)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  entries      AlertEntry[]

  @@index([userId, watchQueryId])
  @@index([userId, createdAt])
}

model AlertEntry {
  id          String           @id @default(cuid())
  containerId String
  externalId  String
  title       String
  authors     String[]
  year        Int?
  abstract    String?
  url         String?
  metadata    Json?
  status      AlertEntryStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  container   AlertContainer   @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([containerId, status])
  @@index([externalId])
  @@unique([containerId, externalId])
}

model EntryCollection {
  id           String   @id @default(cuid())
  entryId      String
  collectionId String
  addedAt      DateTime @default(now())
  entry        Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([entryId, collectionId])
}

model CollectionMember {
  id           String         @id @default(cuid())
  collectionId String
  userId       String
  role         CollectionRole @default(VIEWER)
  invitedBy    String
  invitedAt    DateTime       @default(now())
  acceptedAt   DateTime?
  status       InviteStatus   @default(PENDING)
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter      User           @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@unique([collectionId, userId])
}

model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [usedBy], references: [id], onDelete: SetNull)
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model SharedEntry {
  id          String            @id @default(cuid())
  entryId     String
  senderId    String
  receiverId  String
  message     String?
  status      SharedEntryStatus @default(PENDING)
  sharedAt    DateTime          @default(now())
  respondedAt DateTime?
  entry       Entry             @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sender      User              @relation("SharedEntrySender", fields: [senderId], references: [id])
  receiver    User              @relation("SharedEntryReceiver", fields: [receiverId], references: [id])

  @@unique([entryId, senderId, receiverId])
}

model Signal {
  id           String      @id @default(cuid())
  userId       String
  type         SignalType
  entryId      String?
  collectionId String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  isPublic     Boolean     @default(true)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry        Entry?      @relation(fields: [entryId], references: [id], onDelete: SetNull)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
}

model ReferenceRequest {
  id           String               @id @default(cuid())
  requesterId  String
  ownerId      String
  entryId      String
  message      String?
  status       ReferenceRequestStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  respondedAt  DateTime?
  requester    User                 @relation("ReferenceRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  owner        User                 @relation("ReferenceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  entry        Entry                @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([requesterId, ownerId, entryId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  metadata  Json?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event, timestamp])
  @@index([userId, event])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  message   String   @db.Text
  rating    Int?
  email     String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model QueueItem {
  id           String          @id @default(cuid())
  userId       String
  status       QueueItemStatus @default(PENDING)
  inputType    QueueInputType
  input        String
  payload      Json?
  result       Json?
  entryId      String?
  errorMessage String?
  position     Int
  priority     Int             @default(0)
  createdAt    DateTime        @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String           @db.Text
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
}
