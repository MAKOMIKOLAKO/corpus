generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Topic {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  explanation String?
  keyConcepts String[] @default([])
  createdAt   DateTime @default(now())
}

model User {
  id                        String                   @id @default(cuid())
  email                     String                   @unique
  name                      String?
  createdAt                 DateTime                 @default(now())
  passwordHash              String?
  plan                      Plan                     @default(FREE)
  stripeCustomerId          String?                  @unique
  stripePriceId             String?
  stripeSubscriptionId      String?                  @unique
  subscriptionEndsAt        DateTime?
  subscriptionStatus        String?
  bio                       String?
  emailVerified             DateTime?
  username                  String?                  @unique
  lastFeedViewedAt          DateTime?
  showSignals               Boolean                  @default(true)
  usernameBannerShown       Boolean                  @default(false)
  entriesCount              Int                      @default(0)
  personalCollectionsCount  Int                      @default(0)
  timezone                  String                   @default("UTC")
  alertTime                 String?                  @default("09:00")
  isBetaTester              Boolean                  @default(false)
  alertContainers           AlertContainer[]
  analyticsEvents           AnalyticsEvent[]
  collections               Collection[]
  sentInvites               CollectionMember[]       @relation("InvitedBy")
  collectionMemberships     CollectionMember[]
  receivedConnections       Connection[]             @relation("ConnectionReceiver")
  sentConnections           Connection[]             @relation("ConnectionRequester")
  emailVerificationTokens   EmailVerificationToken[]
  entries                   Entry[]
  feedback                  Feedback[]
  notifications             Notification[]
  passwordResetTokens       PasswordResetToken[]
  promoCodes                PromoCode[]
  queueItems                QueueItem[]
  receivedReferenceRequests ReferenceRequest[]       @relation("ReferenceRequestOwner")
  sentReferenceRequests     ReferenceRequest[]       @relation("ReferenceRequester")
  receivedSharedEntries     SharedEntry[]            @relation("SharedEntryReceiver")
  sentSharedEntries         SharedEntry[]            @relation("SharedEntrySender")
  signals                   Signal[]
  userEntries               UserEntry[]
  generatedBibliographies   GeneratedBibliography[]
  userSources               UserSource[]
  watchQueries              WatchQuery[]
  researchProfile           UserResearchProfile?
  dailyClusters             DailyCluster[]
  dailyPaperScores          DailyPaperScore[]
  dailyBriefs               DailyBrief[]
  readingSessions           PaperReadingSession[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Entry {
  id                String             @id @default(cuid())
  title             String
  authors           String[]
  year              Int?
  contentType       ContentType        @default(PAPER)
  url               String?            @unique
  doi               String?            @unique
  abstract          String?
  summary           String?
  notes             Json               @default("[]")
  readingStatus     ReadingStatus      @default(UNREAD)
  createdAt         DateTime           @default(now())
  cover             String?
  description       String?
  isbn13            String[]           @default([])
  numberOfPages     Int?
  publishDate       String?
  publishers        String[]           @default([])
  userId            String?
  metaDescription   String?
  slug              String?            @unique
  autoKeywords      String[]           @default([])
  userKeywords      String[]           @default([])
  metadata          Json?
  addedByQueryId    String?
  source            EntrySource        @default(MANUAL)
  watchQuery        WatchQuery?        @relation("WatchQueryEntries", fields: [addedByQueryId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  collections       EntryCollection[]
  referenceRequests ReferenceRequest[]
  sharedEntries     SharedEntry[]
  signals           Signal[]
}

model Collection {
  id                String             @id @default(cuid())
  name              String
  description       String?
  createdAt         DateTime           @default(now())
  userId            String?
  isShared          Boolean            @default(false)
  isPublic          Boolean            @default(false)
  publicDescription String?
  publicSlug        String?            @unique
  publicViewCount   Int                @default(0)
  metadata          Json?
  alertContainers   AlertContainer[]
  user              User?              @relation(fields: [userId], references: [id])
  members           CollectionMember[]
  entries           EntryCollection[]
  userEntryCollections UserEntryCollection[]
  signals           Signal[]
  watchQueries      WatchQuery[]
}

model WatchQuery {
  id              String           @id @default(cuid())
  userId          String
  query           String
  collectionId    String
  isActive        Boolean          @default(true)
  lastCheckedAt   DateTime?
  createdAt       DateTime         @default(now())
  maxPapers       Int              @default(5)
  alertContainers AlertContainer[]
  entries         Entry[]          @relation("WatchQueryEntries")
  globalEntries   GlobalEntry[]    @relation("AlertGlobalEntries")
  userEntries     UserEntry[]      @relation("UserAlertEntries")
  collection      Collection       @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastCheckedAt])
  @@index([isActive, lastCheckedAt])
}

model AlertContainer {
  id           String       @id @default(cuid())
  userId       String
  watchQueryId String
  query        String
  collectionId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  collection   Collection?  @relation(fields: [collectionId], references: [id])
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  watchQuery   WatchQuery   @relation(fields: [watchQueryId], references: [id], onDelete: Cascade)
  entries      AlertEntry[]
}

model AlertEntry {
  id          String           @id @default(cuid())
  containerId String
  externalId  String
  title       String
  authors     String[]
  year        Int?
  abstract    String?
  url         String?
  metadata    Json?
  status      AlertEntryStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  container   AlertContainer   @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@unique([containerId, externalId])
  @@index([containerId, status])
  @@index([externalId])
}

model EntryCollection {
  id           String     @id @default(cuid())
  entryId      String
  collectionId String
  addedAt      DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  entry        Entry      @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, collectionId])
}

model CollectionMember {
  id           String         @id @default(cuid())
  collectionId String
  userId       String
  role         CollectionRole @default(VIEWER)
  invitedBy    String
  invitedAt    DateTime       @default(now())
  acceptedAt   DateTime?
  status       InviteStatus   @default(PENDING)
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inviter      User           @relation("InvitedBy", fields: [invitedBy], references: [id])
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
}

model PromoCode {
  id        String    @id @default(cuid())
  code      String    @unique
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [usedBy], references: [id])
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model SharedEntry {
  id            String            @id @default(cuid())
  entryId       String
  globalEntryId String?
  senderId      String
  receiverId    String
  message       String?
  status        SharedEntryStatus @default(PENDING)
  sharedAt      DateTime          @default(now())
  respondedAt   DateTime?
  entry         Entry             @relation(fields: [entryId], references: [id], onDelete: Cascade)
  globalEntry   GlobalEntry?      @relation("GlobalEntryShared", fields: [globalEntryId], references: [id], onDelete: SetNull)
  sender        User              @relation("SharedEntrySender", fields: [senderId], references: [id])
  receiver      User              @relation("SharedEntryReceiver", fields: [receiverId], references: [id])

  @@unique([entryId, senderId, receiverId])
}

model Signal {
  id           String      @id @default(cuid())
  userId       String
  type         SignalType
  entryId      String?
  globalEntryId String?
  collectionId String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  isPublic     Boolean     @default(true)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry        Entry?      @relation(fields: [entryId], references: [id], onDelete: SetNull)
  globalEntry  GlobalEntry? @relation("GlobalEntrySignals", fields: [globalEntryId], references: [id], onDelete: SetNull)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
}

model ReferenceRequest {
  id           String               @id @default(cuid())
  requesterId  String
  ownerId      String
  entryId      String
  globalEntryId String?
  message      String?
  status       ReferenceRequestStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  respondedAt  DateTime?
  requester    User                 @relation("ReferenceRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  owner        User                 @relation("ReferenceRequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  entry        Entry                @relation(fields: [entryId], references: [id], onDelete: Cascade)
  globalEntry  GlobalEntry?         @relation("GlobalEntryReferenceRequests", fields: [globalEntryId], references: [id], onDelete: SetNull)

  @@unique([requesterId, ownerId, entryId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  metadata  Json?
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([event, timestamp])
  @@index([userId, event])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  message   String
  rating    Int?
  email     String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model QueueItem {
  id           String          @id @default(cuid())
  userId       String
  status       QueueItemStatus @default(PENDING)
  inputType    QueueInputType
  input        String
  payload      Json?
  result       Json?
  entryId      String?
  globalEntryId String?
  errorMessage String?
  position     Int
  createdAt    DateTime        @default(now())
  startedAt    DateTime?
  completedAt  DateTime?
  priority     Int             @default(0)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  globalEntry  GlobalEntry?    @relation("GlobalEntryQueueItems", fields: [globalEntryId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum ContentType {
  PAPER
  BOOK
  ARTICLE
  BLOG
  ESSAY
  POLICY_REPORT
  OTHER
}

enum QueueItemStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum QueueInputType {
  URL
  PAPER
  BOOK
}

enum ReadingStatus {
  UNREAD
  READING
  READ
  BACKLOG
  IN_PROGRESS
  COMPLETED
  DROPPED
}

enum Plan {
  FREE
  PRO
  LIFETIME_PRO
}

enum CollectionRole {
  VIEWER
  CONTRIBUTOR
  ADMIN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum SharedEntryStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum SignalType {
  ENTRY_SAVED
  ENTRY_ADDED_TO_COLLECTION
  COLLECTION_MADE_PUBLIC
  CONNECTION_MADE
  PAPER_SHARED
  REFERENCE_REQUESTED
  COLLECTION_MEMBER_JOINED
}

enum ReferenceRequestStatus {
  PENDING
  ACKNOWLEDGED
  DISMISSED
}

enum EntrySource {
  MANUAL
  SMART_ALERT
}

enum NotificationType {
  SMART_ALERT
  CONNECTION_REQUEST
  SHARED_ENTRY
  COLLECTION_INVITE
}

enum AlertEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

model GlobalEntry {
  id              String    @id @default(cuid())
  
  // Primary deduplication keys
  doi             String?   @unique
  isbn            String?   @unique
  
  // Secondary deduplication key (title + first author + year)
  // Stored normalized for comparison
  normalizedTitle     String?
  normalizedFirstAuthor String?
  publicationYear     Int?
  
  // Tertiary deduplication key
  canonicalUrl    String?   @unique
  
  // Content hash for additional safety
  // SHA-256 of: normalized(title + firstAuthor + year) or canonical URL
  contentHash     String?   @unique
  
  // Core metadata (shared across all users)
  title           String
  authors         String[]
  year            Int?
  abstract        String?
  summary         String?   // AI-generated summary
  source          String?   // journal, website, publisher
  url             String?   // original URL (not normalized)
  
  // Type information retained in DB but not shown in UI
  rawContentType  String?   // stores original contentType value silently
  
  // AI-generated data (shared, generated once)
  // Note: embedding field omitted until pgvector is properly installed
  
  // Stored metadata (book pages, openAccessUrl, semanticScholarId etc.)
  metadata        Json?
  
  // Source tracking
  addedVia        String?   // "manual", "semantic_scholar", "open_library", 
                            // "crossref", "url_fetch", "smart_alert"
  
  // Global stats
  saveCount       Int       @default(0)  // incremented when any user saves this
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  userEntries     UserEntry[]
  sharedEntries   SharedEntry[]   @relation("GlobalEntryShared")
  alertEntries    WatchQuery[]    @relation("AlertGlobalEntries")
  signals         Signal[]        @relation("GlobalEntrySignals")
  referenceRequests ReferenceRequest[] @relation("GlobalEntryReferenceRequests")
  queueItems      QueueItem[]     @relation("GlobalEntryQueueItems")
  
  // Indexes for deduplication lookups
  @@index([doi])
  @@index([isbn])
  @@index([canonicalUrl])
  @@index([contentHash])
  @@index([normalizedTitle, normalizedFirstAuthor, publicationYear])
  @@index([saveCount])
}

model UserEntry {
  id              String    @id @default(cuid())
  
  // Core relations
  userId          String
  globalEntryId   String
  
  // Per-user state
  readingStatus   ReadingStatus @default(UNREAD)
  notes           String?   // User's personal notes about this entry
  
  // Source tracking per user
  addedVia        String?   // "manual", "smart_alert", "shared", "collection"
  addedByQueryId  String?   // WatchQuery.id if added via smart alert
  
  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastViewedAt    DateTime?
  
  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  globalEntry     GlobalEntry @relation(fields: [globalEntryId], references: [id], onDelete: Cascade)
  collections     UserEntryCollection[]
  addedByQuery    WatchQuery? @relation("UserAlertEntries", fields: [addedByQueryId], references: [id], onDelete: SetNull)
  
  // One UserEntry per user per GlobalEntry
  @@unique([userId, globalEntryId])
  @@index([userId])
  @@index([globalEntryId])
  @@index([userId, readingStatus])
  @@index([userId, createdAt])
}

model UserEntryCollection {
  id            String    @id @default(cuid())
  userEntryId   String
  collectionId  String
  addedAt       DateTime  @default(now())
  
  userEntry     UserEntry   @relation(fields: [userEntryId], references: [id], onDelete: Cascade)
  collection    Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  
  @@unique([userEntryId, collectionId])
  @@index([collectionId])
  @@index([userEntryId])
}

model Source {
  id            String   @id @default(cuid())
  feedUrl       String   @unique
  domain        String
  title         String?
  lastFetchedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  userSources   UserSource[]
  
  @@index([feedUrl])
  @@index([domain])
  @@index([lastFetchedAt])
}

model DefaultFeed {
  id          String      @id @default(cuid())
  name        String
  url         String      @unique
  category    String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  userSources UserSource[]

  @@index([category])
  @@index([isActive])
}

model UserSource {
  id            String       @id @default(cuid())
  userId        String
  sourceId      String
  feedUrl       String
  isDefault     Boolean      @default(false)
  defaultFeedId String?
  createdAt     DateTime     @default(now())
  
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  source        Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  defaultFeed   DefaultFeed? @relation(fields: [defaultFeedId], references: [id], onDelete: SetNull)
  
  @@unique([userId, sourceId])
  @@unique([userId, feedUrl])
  @@index([userId])
  @@index([sourceId])
  @@index([feedUrl])
  @@index([defaultFeedId])
}

model GeneratedBibliography {
  id                   String   @id @default(cuid())
  userId               String
  title                String?
  entryIds             String[]
  citationStyle        String
  ordering             String
  content              String
  relatedWorkParagraph String?
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ===== RESEARCH READING SYSTEM =====

model CandidatePaper {
  id                String    @id @default(cuid())
  doi               String?   @unique
  arxivId           String?   @unique
  title             String
  authors           String[]
  abstract          String?
  url               String?
  source            String?
  publishedDate     DateTime?
  // Embedding stored as Json array (number[]) since pgvector is not installed
  embedding         Json?     // number[] — 768-dim Gemini text-embedding-004
  candidateMetadata Json?     // { methodology, domainTags, noveltyIndicators, complexityScore }
  plainSummary      String?   // cached, user-agnostic
  technicalSummary  String?   // cached, user-agnostic
  noveltyTag        String?
  ingestedAt        DateTime  @default(now())
  embeddedAt        DateTime?

  dailyScores       DailyPaperScore[]
  readingSessions   PaperReadingSession[]

  @@index([publishedDate, embeddedAt])
  @@index([doi])
  @@index([ingestedAt])
}

model UserResearchProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  interestVector          Json?    // number[] — centroid of user's GlobalEntry embeddings
  domainWeights           Json?    // Record<string, number> — domain tag frequency map
  dismissedPaperIds       String[] // CandidatePaper ids the user has dismissed
  preferredDailyCount     Int      @default(5)
  lastRecomputedAt        DateTime?
  feedSelectionMode       String   @default("profile") // "profile" | "collection" | "phrase"
  feedSelectionCollectionId String? // Collection ID for collection-based feed generation
  feedSelectionPhrase     String? // Research phrase for phrase-based feed generation
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DailyCluster {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime // store as date-only (truncate to midnight UTC)
  clusterIndex Int
  label        String
  centroid     Json     // number[] embedding centroid
  paperIds     String[] // CandidatePaper ids in this cluster

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, clusterIndex])
  @@index([userId, date])
}

model DailyPaperScore {
  id                String        @id @default(cuid())
  userId            String
  candidatePaperId  String
  date              DateTime
  compositeScore    Float
  semanticScore     Float
  domainScore       Float
  noveltyScore      Float
  citationScore     Float
  engagementScore   Float

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidatePaper CandidatePaper @relation(fields: [candidatePaperId], references: [id], onDelete: Cascade)

  @@unique([userId, date, candidatePaperId])
  @@index([userId, date, compositeScore])
}

model DailyBrief {
  id                      String    @id @default(cuid())
  userId                  String
  date                    DateTime  // truncated to midnight UTC
  selectedPaperIds        String[]  // ordered CandidatePaper ids
  whyExplanations         Json      // Record<candidatePaperId, string>
  emergingTrendsParagraph String?
  generatedAt             DateTime  @default(now())
  viewedAt                DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model PaperReadingSession {
  id               String    @id @default(cuid())
  userId           String
  candidatePaperId String?
  globalEntryId    String?
  paperText        String    @db.Text
  sections         Json      // SectionObject[]
  notes            String?   // User's notes for this session
  sessionStarted   DateTime  @default(now())
  lastActivity     DateTime  @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidatePaper CandidatePaper? @relation(fields: [candidatePaperId], references: [id], onDelete: SetNull)
  messages      PaperReadingMessage[]

  @@index([userId, lastActivity])
}

model PaperReadingMessage {
  id                 String   @id @default(cuid())
  sessionId          String
  role               String   // "user" | "assistant"
  content            String   @db.Text
  referencedSections String[]
  createdAt          DateTime @default(now())

  session PaperReadingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
}
