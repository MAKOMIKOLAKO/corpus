generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  PAPER
  BLOG
  ESSAY
  ARTICLE
  POLICY_REPORT
  BOOK
  VIDEO
  SOCIAL_POST
  OTHER
}

enum ReadingStatus {
  UNREAD
  READING
  READ
}

enum Plan {
  FREE
  PRO
  LIFETIME_PRO
}

enum CollectionRole {
  VIEWER
  CONTRIBUTOR
  ADMIN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum SharedEntryStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum SignalType {
  ENTRY_SAVED
  ENTRY_ADDED_TO_COLLECTION
  COLLECTION_MADE_PUBLIC
  CONNECTION_MADE
  PAPER_SHARED
  REFERENCE_REQUESTED
}

enum LabRole {
  MEMBER
  ADMIN
}

enum ReferenceRequestStatus {
  PENDING
  ACKNOWLEDGED
  DISMISSED
}

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  name                  String?
  username              String?     @unique
  bio                   String?
  passwordHash          String?
  plan                  Plan        @default(FREE)
  stripeCustomerId      String?     @unique
  stripeSubscriptionId  String?     @unique
  stripePriceId         String?
  subscriptionStatus    String?
  subscriptionEndsAt    DateTime?
  emailVerified         DateTime?
  createdAt             DateTime    @default(now())
  showSignals           Boolean     @default(true)
  lastFeedViewedAt      DateTime?
  institutionId         String?
  institutionVerifiedAt DateTime?

  entries               Entry[]
  collections           Collection[]
  promoCodes            PromoCode[]
  collectionMemberships CollectionMember[]
  sentInvites           CollectionMember[]  @relation("InvitedBy")
  sentConnections       Connection[]        @relation("ConnectionRequester")
  receivedConnections   Connection[]        @relation("ConnectionReceiver")
  sentSharedEntries     SharedEntry[]       @relation("SharedEntrySender")
  receivedSharedEntries SharedEntry[]       @relation("SharedEntryReceiver")
  passwordResetTokens   PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  signals               Signal[]
  institution           Institution?       @relation(fields: [institutionId], references: [id])
  labMemberships        LabMember[]
  createdLabs           Lab[]              @relation("LabCreator")
  sentReferenceRequests ReferenceRequest[] @relation("ReferenceRequester")
  receivedReferenceRequests ReferenceRequest[] @relation("ReferenceOwner")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Entry {
  id            String        @id @default(cuid())
  title         String
  authors       String[]
  year          Int?
  contentType   ContentType   @default(PAPER)
  url           String?       @unique
  doi           String?       @unique
  source        String?
  abstract      String?
  publishers    String[]      @default([])
  publishDate   String?
  numberOfPages Int?
  description   String?
  isbn13        String[]      @default([])
  cover         String?
  autoKeywords  String[]
  userKeywords  String[]
  topics        String[]
  summary       String?
  notes         Json          @default("[]")
  readingStatus ReadingStatus @default(UNREAD)
  createdAt     DateTime      @default(now())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  collections   EntryCollection[]
  sharedEntries SharedEntry[]
  signals       Signal[]
  referenceRequests ReferenceRequest[]
}

model Collection {
  id               String             @id @default(cuid())
  name             String
  description      String?
  isShared         Boolean            @default(false)
  isPublic         Boolean            @default(false)
  publicSlug       String?            @unique
  publicDescription String?           @db.Text
  publicViewCount  Int                @default(0)
  createdAt        DateTime           @default(now())
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  entries          EntryCollection[]
  members          CollectionMember[]
  signals          Signal[]
}

model EntryCollection {
  id           String   @id @default(cuid())
  entryId      String
  collectionId String
  addedAt      DateTime @default(now())
  entry        Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([entryId, collectionId])
}

model CollectionMember {
  id           String         @id @default(cuid())
  collectionId String
  userId       String
  role         CollectionRole @default(VIEWER)
  invitedBy    String
  invitedAt    DateTime       @default(now())
  acceptedAt   DateTime?
  status       InviteStatus   @default(PENDING)
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter      User           @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@unique([collectionId, userId])
}

model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [usedBy], references: [id], onDelete: SetNull)
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model SharedEntry {
  id          String            @id @default(cuid())
  entryId     String
  senderId    String
  receiverId  String
  message     String?
  status      SharedEntryStatus @default(PENDING)
  sharedAt    DateTime          @default(now())
  respondedAt DateTime?
  entry       Entry             @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sender      User              @relation("SharedEntrySender", fields: [senderId], references: [id])
  receiver    User              @relation("SharedEntryReceiver", fields: [receiverId], references: [id])

  @@unique([entryId, senderId, receiverId])
}

model Signal {
  id           String      @id @default(cuid())
  userId       String
  type         SignalType
  entryId      String?
  collectionId String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  isPublic     Boolean     @default(true)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entry        Entry?      @relation(fields: [entryId], references: [id], onDelete: SetNull)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)
}

model Institution {
  id          String   @id @default(cuid())
  name        String
  domain      String   @unique
  shortName   String
  logoUrl     String?
  createdAt   DateTime @default(now())
  members     User[]
  labs        Lab[]
}

model InstitutionVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  code      String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model Lab {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  institutionId String
  createdBy     String
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  institution   Institution @relation(fields: [institutionId], references: [id])
  members       LabMember[]
  creator       User     @relation("LabCreator", fields: [createdBy], references: [id])
}

model LabMember {
  id       String   @id @default(cuid())
  labId    String
  userId   String
  role     LabRole  @default(MEMBER)
  joinedAt DateTime @default(now())
  lab      Lab      @relation(fields: [labId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([labId, userId])
}

model ReferenceRequest {
  id           String               @id @default(cuid())
  requesterId  String
  ownerId      String
  entryId      String
  message      String?
  status       ReferenceRequestStatus @default(PENDING)
  createdAt    DateTime             @default(now())
  respondedAt  DateTime?
  requester    User                 @relation("ReferenceRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  owner        User                 @relation("ReferenceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  entry        Entry                @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([requesterId, ownerId, entryId])
}
