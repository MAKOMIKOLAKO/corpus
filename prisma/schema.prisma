generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  PAPER
  BLOG
  ESSAY
  ARTICLE
  POLICY_REPORT
  BOOK
  VIDEO
  SOCIAL_POST
  OTHER
}

enum ReadingStatus {
  UNREAD
  READING
  READ
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  name      String?
  createdAt DateTime    @default(now())

  entries     Entry[]
  collections Collection[]
}

model Entry {
  id            String        @id @default(cuid())
  title         String
  authors       String[]
  year          Int?
  contentType   ContentType   @default(PAPER)
  url           String?       @unique
  doi           String?       @unique
  source        String?
  abstract      String?
  publishers    String[]      @default([])
  publishDate   String?
  numberOfPages Int?
  description   String?
  isbn13        String[]      @default([])
  cover         String?
  autoKeywords  String[]
  userKeywords  String[]
  topics        String[]
  summary       String?
  notes         Json          @default("[]")
  readingStatus ReadingStatus @default(UNREAD)
  createdAt     DateTime      @default(now())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  collections   EntryCollection[]
}

model Collection {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  entries     EntryCollection[]
}

model EntryCollection {
  id           String   @id @default(cuid())
  entryId      String
  collectionId String
  addedAt      DateTime @default(now())
  entry        Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([entryId, collectionId])
}
