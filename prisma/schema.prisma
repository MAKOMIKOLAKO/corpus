generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContentType {
  PAPER
  BLOG
  ESSAY
  ARTICLE
  POLICY_REPORT
  BOOK
  VIDEO
  SOCIAL_POST
  OTHER
}

enum ReadingStatus {
  UNREAD
  READING
  READ
}

enum Plan {
  FREE
  PRO
  LIFETIME_PRO
}

enum CollectionRole {
  VIEWER
  CONTRIBUTOR
  ADMIN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum SharedEntryStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  name                  String?
  username              String?     @unique
  bio                   String?
  passwordHash          String?
  plan                  Plan        @default(FREE)
  stripeCustomerId      String?     @unique
  stripeSubscriptionId  String?     @unique
  stripePriceId         String?
  subscriptionStatus    String?
  subscriptionEndsAt    DateTime?
  createdAt             DateTime    @default(now())

  entries               Entry[]
  collections           Collection[]
  promoCodes            PromoCode[]
  collectionMemberships CollectionMember[]
  sentInvites           CollectionMember[]  @relation("InvitedBy")
  sentConnections       Connection[]        @relation("ConnectionRequester")
  receivedConnections   Connection[]        @relation("ConnectionReceiver")
  sentSharedEntries     SharedEntry[]       @relation("SharedEntrySender")
  receivedSharedEntries SharedEntry[]       @relation("SharedEntryReceiver")
}

model Entry {
  id            String        @id @default(cuid())
  title         String
  authors       String[]
  year          Int?
  contentType   ContentType   @default(PAPER)
  url           String?       @unique
  doi           String?       @unique
  source        String?
  abstract      String?
  publishers    String[]      @default([])
  publishDate   String?
  numberOfPages Int?
  description   String?
  isbn13        String[]      @default([])
  cover         String?
  autoKeywords  String[]
  userKeywords  String[]
  topics        String[]
  summary       String?
  notes         Json          @default("[]")
  readingStatus ReadingStatus @default(UNREAD)
  createdAt     DateTime      @default(now())
  userId        String?
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  collections   EntryCollection[]
  sharedEntries SharedEntry[]
}

model Collection {
  id          String             @id @default(cuid())
  name        String
  description String?
  isShared    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  entries     EntryCollection[]
  members     CollectionMember[]
}

model EntryCollection {
  id           String   @id @default(cuid())
  entryId      String
  collectionId String
  addedAt      DateTime @default(now())
  entry        Entry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([entryId, collectionId])
}

model CollectionMember {
  id           String         @id @default(cuid())
  collectionId String
  userId       String
  role         CollectionRole @default(VIEWER)
  invitedBy    String
  invitedAt    DateTime       @default(now())
  acceptedAt   DateTime?
  status       InviteStatus   @default(PENDING)
  collection   Collection     @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter      User           @relation("InvitedBy", fields: [invitedBy], references: [id])

  @@unique([collectionId, userId])
}

model PromoCode {
  id        String   @id @default(cuid())
  code      String   @unique
  usedBy    String?
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [usedBy], references: [id], onDelete: SetNull)
}

model Connection {
  id          String           @id @default(cuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
}

model SharedEntry {
  id          String            @id @default(cuid())
  entryId     String
  senderId    String
  receiverId  String
  message     String?
  status      SharedEntryStatus @default(PENDING)
  sharedAt    DateTime          @default(now())
  respondedAt DateTime?
  entry       Entry             @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sender      User              @relation("SharedEntrySender", fields: [senderId], references: [id])
  receiver    User              @relation("SharedEntryReceiver", fields: [receiverId], references: [id])

  @@unique([entryId, senderId, receiverId])
}
