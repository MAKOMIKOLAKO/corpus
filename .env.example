# Database (Neon: use sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://yourdomain.com
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
ADMIN_EMAIL=your-admin-email

# Google OAuth
GOOGLE_CLIENT_ID=from-google-cloud-console
GOOGLE_CLIENT_SECRET=from-google-cloud-console
ALLOWED_GOOGLE_EMAIL=your-google-email

# AI (Google GenAI / Gemini — used by summarization and queue processing)
GOOGLE_AI_API_KEY=your-google-ai-api-key
GEMINI_API_KEY=optional-fallback-same-as-above

# Optional: Semantic Scholar (paper add flow)
SEMANTIC_SCHOLAR_API_KEY=from-semanticscholar.org

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# Stripe
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_if-used-client-side
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_MONTHLY_PRICE_ID=price_...  # $7/month
STRIPE_ANNUAL_PRICE_ID=price_...   # $60/year

# App URL (also used for CORS when CORS_ORIGIN is unset)
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# Optional: override CORS Allow-Origin (default: NEXT_PUBLIC_APP_URL or localhost in dev)
CORS_ORIGIN=https://usecorpus.app

# Server-side API key for legacy x-api-key header on some routes (must match client)
KEY=your-secret-api-key-here

# Cron job secret for securing scheduled tasks
CRON_SECRET=generate-with-openssl-rand-hex-32

# Optional: distributed rate limits (otherwise in-memory per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
