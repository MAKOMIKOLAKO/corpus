# Database (Neon: use sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Authentication
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://yourdomain.com
ADMIN_USER_IDS=userId1,userId2,userId3

# Google OAuth
GOOGLE_CLIENT_ID=from-google-cloud-console
GOOGLE_CLIENT_SECRET=from-google-cloud-console
ALLOWED_GOOGLE_EMAIL=your-google-email

# AI (Google GenAI / Gemini — used by summarization and queue processing)
GOOGLE_AI_API_KEY=your-google-ai-api-key
GEMINI_API_KEY=optional-fallback-same-as-above

# Optional: Semantic Scholar (paper add flow)
SEMANTIC_SCHOLAR_API_KEY=from-semanticscholar.org

# Email (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.com

# App URL (also used for CORS when CORS_ORIGIN is unset)
NEXT_PUBLIC_APP_URL=https://yourdomain.com
# Optional: override CORS Allow-Origin (default: NEXT_PUBLIC_APP_URL or localhost in dev)
CORS_ORIGIN=https://usecorpus.app

# Cron job secret for authentication
CRON_SECRET=your_cron_secret_here

# Optional: distributed rate limits (otherwise in-memory per instance)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
